# Copy this file to .env on the server and fill it in:  cp .env.example .env

# Camera the server should read (until an admin changes it in Settings).
# Office IP camera / NVR over Tailscale, for example:
#   rtsp://USER:PASSWORD@100.x.y.z:554/Streaming/Channels/102
CAMERA_SOURCE=

# Leave as :80 to open the dashboard at http://SERVER-IP
# For https (needed for "Use this browser's webcam"):
#   free, no domain needed:  SITE_ADDRESS=13-238-25-153.sslip.io   (your IP with dashes)
#   or your own domain:      SITE_ADDRESS=attendance.yourdomain.com
SITE_ADDRESS=:80

# Optional, only together with an https SITE_ADDRESS: your server's IP, so the
# old http://IP link forwards to the https link.
# PUBLIC_IP=13.238.25.153
